knitr::opts_chunk$set(echo = TRUE, fig.width = 3, fig.height = 3, fig.align = "center")
options(digits = 4)
library(dplyr)
library(data.table)
gc()
rm(list=ls())
Y  <- c(6,  2,  7,  31)
X1 <- c(23, 22, 28, 40)
print(data.frame(Y = Y, X = X1))
X <- matrix(data = c(1,1,1,1,X1), nrow=4)
print(X)
X_t <- t(X)
dim(X_t)
XtX <- X_t %*% X
## get the inverse
XtX_inv <- solve(XtX)
print(XtX_inv)
round(XtX_inv %*% XtX)
beta_hat <- XtX_inv %*% X_t %*% Y
print(beta_hat)
Y_pred <- X %*% beta_hat
e = Y-Y_pred
print(e)
dim(e)
sigma2_hat <- sum(e^2) / (4-2)
print(sigma2_hat)
var_beta_hat <- sigma2_hat * XtX_inv
print(var_beta_hat)
beta_0_hat_se <- sqrt(diag(var_beta_hat))[1]
beta_0_hat_se
beta_1_hat_se <- sqrt(diag(var_beta_hat))[2]
beta_1_hat_se
beta1_hat <- beta_hat[2]
t_stat_b1 <- abs(beta1_hat / beta_1_hat_se)
beta1_hat_p <- 2 * pt(t_stat_b1, df = 4-2, lower.tail = F)
print(beta1_hat_p)
qt(0.05/2, 2) # 2.5th
qt(1-0.05/2, 2) # 97.5
beta1_0025 <- qt(0.05/2, 2) * beta_1_hat_se
beta1_0025
beta1_0975 <- qt(1-0.05/2, 2) * beta_1_hat_se
beta1_0975
## the confidence interval
beta_1_hat_lci <- beta1_hat - qt(1-0.05/2,2)*beta_1_hat_se
beta_1_hat_uci <- beta1_hat + qt(1-0.05/2,2)*beta_1_hat_se
beta_1_hat_lci
beta_1_hat_uci
# the p values
2 * pt(abs((beta1_hat - 2.7)/ beta_1_hat_se), df = 4-2, lower.tail = F)
# the p values
2 * pt(abs((beta1_hat - 2.7)/ beta_1_hat_se), df = 4-2, lower.tail = F)
# the p values
2 * pt(abs((beta1_hat - 2.7)/ beta_1_hat_se), df = 4-2, lower.tail = F)
# the p values
2 * pt(abs((beta1_hat - 2.5)/ beta_1_hat_se), df = 4-2, lower.tail = F)
# the p values
2 * pt(abs((beta1_hat - 1)/ beta_1_hat_se), df = 4-2, lower.tail = F)
# the p values
2 * pt(abs((beta1_hat - 1)/ beta_1_hat_se), df = 4-2, lower.tail = F)
# the p values
2 * pt(abs((beta1_hat - 0.5)/ beta_1_hat_se), df = 4-2, lower.tail = F)
# the p values
2 * pt(abs((beta1_hat - 0.4)/ beta_1_hat_se), df = 4-2, lower.tail = F)
